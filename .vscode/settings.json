{
  // 用项目自带的 venv —— 系统 Python 缺依赖（PEP 668）
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // 本项目用 stdlib unittest，不用 pytest
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-v", "-s", "./tests", "-t", "."],
  "python.testing.cwd": "${workspaceFolder}",

  // 中文注释是项目规范（BRIEF.md），不让它报「非 ASCII」
  "files.encoding": "utf8",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // 长文档（DEPLOY/README）读起来舒服些
  "editor.rulers": [88],
  "editor.wordWrapColumn": 88,
  "[markdown]": { "editor.wordWrap": "on", "editor.rulers": [] },

  // 搜索时别被产物干扰
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/*.db": true,
    "**/docs/images": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true
  }
}
